# Keep repository source files consistently Unix-style.
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf

# Never apply text conversion to binary files.
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.zip  binary
